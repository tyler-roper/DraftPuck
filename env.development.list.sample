# Connection Strings
DRAFTPUCK_ConnectionStrings__DefaultConnection=Server=host.docker.internal,1433;Database=DraftPuck;User Id=sa;Password=<SA_PASSWORD>;Encrypt=false;
DRAFTPUCK_ConnectionStrings__LocalConnection=Server=localhost;Database=DraftPuck;Trusted_Connection=True;Encrypt=false;

# Application Settings
DRAFTPUCK_APPLICATION__BASEPATH=http://localhost:17010
DRAFTPUCK_APPLICATION__ISTESTMODE=false
DRAFTPUCK_APPLICATION__TestModeStartDateTimeUtc=2025-10-31T00:30:00
DRAFTPUCK_APPLICATION__InternalApiKey=local-development
DRAFTPUCK_APPLICATION__InternalApiBasePath=http://draftpuck.web:17001/

# Automapper License
DRAFTPUCK_AUTOMAPPER__LICENSEKEY=<AUTOMAPPER_LICENSE_KEY>

# Firebase
DRAFTPUCK_FIREBASE__Type=service_account
DRAFTPUCK_FIREBASE__ProjectId=draftpuck
DRAFTPUCK_FIREBASE__PrivateKeyId=<FIREBASE_PRIVATE_KEY_ID>
DRAFTPUCK_FIREBASE__PrivateKey=<FIREBASE_PRIVATE_KEY>
DRAFTPUCK_FIREBASE__ClientEmail=<FIREBASE_CLIENT_EMAIL>
DRAFTPUCK_FIREBASE__ClientId=<FIREBASE_CLIENT_ID>
DRAFTPUCK_FIREBASE__AuthUri=https://accounts.google.com/o/oauth2/auth
DRAFTPUCK_FIREBASE__TokenUri=https://oauth2.googleapis.com/token
DRAFTPUCK_FIREBASE__AuthProviderX509CertUrl=https://www.googleapis.com/oauth2/v1/certs
DRAFTPUCK_FIREBASE__ClientX509CertUrl=<FIREBASE_CLIENT_CERT_URL>
DRAFTPUCK_FIREBASE__UniverseDomain=googleapis.com
DRAFTPUCK_FIREBASE__VapidKey=<FIREBASE_VAPID_KEY>
DRAFTPUCK_FIREBASE__ApiKey=<FIREBASE_API_KEY>
DRAFTPUCK_FIREBASE__AuthDomain=<FIREBASE_AUTH_DOMAIN>
DRAFTPUCK_FIREBASE__StorageBucket=<FIREBASE_STORAGE_BUCKET>
DRAFTPUCK_FIREBASE__SenderId=<FIREBASE_SENDER_ID>
DRAFTPUCK_FIREBASE__AppId=<FIREBASE_APP_ID>

# Auth
DRAFTPUCK_AUTH__JWTKEY=<JWT_KEY>
DRAFTPUCK_AUTH__ISSUER=urn:draftpuck
DRAFTPUCK_AUTH__AUDIENCE=urn:draftpuck

# Azure Storage
AzureWebJobsStorage=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://host.docker.internal:10000/devstoreaccount1;QueueEndpoint=http://host.docker.internal:10001/devstoreaccount1;TableEndpoint=http://host.docker.internal:10002/devstoreaccount1;
DRAFTPUCK_AZURESTORAGE__CONNECTIONSTRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://host.docker.internal:10000/devstoreaccount1;QueueEndpoint=http://host.docker.internal:10001/devstoreaccount1;TableEndpoint=http://host.docker.internal:10002/devstoreaccount1;

# Redis
DRAFTPUCK_Redis__ConnectionString=redis:6379,abortConnect=false

# Discord
DRAFTPUCK_DISCORD__ClientId=<DISCORD_CLIENT_ID>
DRAFTPUCK_DISCORD__RedirectUri=http://localhost:17010/api/discord/callback
DRAFTPUCK_DISCORD__ClientSecret=<DISCORD_CLIENT_SECRET>
DRAFTPUCK_DISCORD__BotToken=<DISCORD_BOT_TOKEN>
DRAFTPUCK_DISCORD__GuildId=<DISCORD_GUILD_ID>

# Misc
DRAFTPUCK_NHL__DelayInMilliseconds=500

# Logging
DRAFTPUCK_LOGGING__LOGLEVEL__DEFAULT=Debug
DRAFTPUCK_LOGGING__LOGLEVEL__Microsoft__AspNetCore__Authentication=Debug
DRAFTPUCK_LOGGING__LOGLEVEL__Microsoft__IdentityModel=Debug
