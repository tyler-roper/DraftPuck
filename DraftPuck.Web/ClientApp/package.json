{
  "name": "draftpuck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build:debug": "run-p type-check build-only:debug",
    "build:release": "run-p type-check build-only:release",
    "preview": "vite preview",
    "build-only:debug": "vite build --mode=debug --emptyOutDir",
    "build-only:release": "vite build --mode=release --emptyOutDir",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false && vue-tsc --noEmit -p tsconfig.node.json --composite false",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@microsoft/signalr": "^8.0.0-rc.2.23480.2",
    "@types/pulltorefreshjs": "^0.1.7",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.5.1",
    "bootstrap": "^5.3.2",
    "date-fns": "^2.30.0",
    "fast-json-patch": "^3.1.1",
    "firebase": "^11.10.0",
    "pinia": "^2.1.6",
    "pulltorefreshjs": "^0.1.22",
    "sass": "^1.69.3",
    "vue": "^3.3.4",
    "vue-countup-v3": "^1.4.2",
    "vue-router": "^4.2.4",
    "vue-smart-suggest": "^1.1.0",
    "vue3-popper": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.7",
    "@types/bootstrap": "^5.2.8",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
