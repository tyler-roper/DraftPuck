{
  "name": "draftpuck",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:debug": "run-p type-check build-only:debug",
    "build:release": "run-p type-check build-only:release",
    "preview": "vite preview",
    "build-only:debug": "vite build --mode=debug --emptyOutDir",
    "build-only:release": "vite build --mode=release --emptyOutDir",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@microsoft/signalr": "^8.0.0-rc.2.23480.2",
    "@types/pulltorefreshjs": "^0.1.7",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "axios": "^1.5.1",
    "bootstrap": "^5.3.2",
    "date-fns": "^2.30.0",
    "fast-json-patch": "^3.1.1",
    "firebase": "^11.2.0",
    "pinia": "^2.1.6",
    "pulltorefreshjs": "^0.1.22",
    "sass": "^1.69.3",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "vue-smart-suggest": "^1.1.0",
    "vue-toastification": "^2.0.0-rc.5",
    "vue3-popper": "^1.5.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/bootstrap": "^5.2.8",
    "@types/node": "^18.17.17",
    "@vitejs/plugin-vue": "^4.3.4",
    "@vitejs/plugin-vue-jsx": "^3.0.2",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "npm-run-all2": "^6.0.6",
    "prettier": "^3.0.3",
    "terser": "^5.44.1",
    "typescript": "~5.2.0",
    "vite": "^4.4.9",
    "vue-tsc": "^1.8.11"
  }
}
