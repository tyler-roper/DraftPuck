{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@/*": ["./src/*"],
      // The package ships declarations but its "exports" and "types" fields don't lead to them.
      "vue-smart-suggest": ["./node_modules/vue-smart-suggest/lib/index.d.ts"]
    }
  }
}
